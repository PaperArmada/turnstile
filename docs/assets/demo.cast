{"version": 2, "width": 80, "height": 24, "timestamp": 1779251157, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.107201, "o", "\r\nTurnstile: 60-second demo\r\nProcess: peer-review (submit → review → revise → accept)\r\n"]
[1.307455, "o", "\r\n━━━ 1. Agent starts a peer-review instance ━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n"]
[2.50748, "o", "  agent:\r\n  $ process_start(\"peer-review\", {artifact: \"API design doc\"})\r\n"]
[3.108082, "o", "    → state: start    role: (none)\r\n      instance: 1cb0a3\r\n"]
[4.30937, "o", "\r\n━━━ 2. Transition to 'prepare' (role: submitter) ━━━━━━━━━━━━━━━━\r\n\r\n"]
[5.509611, "o", "  agent:\r\n  $ process_transition(\"1cb0a3\", \"prepare\")\r\n"]
[6.110322, "o", "    → state: prepare    role: submitter\r\n      agent_context provisioned for submitter\r\n"]
[7.310517, "o", "\r\n━━━ 3. Submit for review (wait state, role: reviewer) ━━━━━━━━━━━\r\n\r\n"]
[8.510631, "o", "  agent:\r\n  $ process_transition(\"1cb0a3\", \"awaiting_review\")\r\n"]
[9.116573, "o", "    → state: awaiting_review    role: reviewer\r\n      ⏸ waiting for signal: review_decision\r\n"]
[10.316838, "o", "\r\n━━━ 4. Try to skip ahead; engine rejects ━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n"]
[11.517881, "o", "  agent:\r\n  $ process_transition(\"1cb0a3\", \"accepted\")\r\n"]
[12.118259, "o", "    ✗ rejected: Instance is waiting for a signal. Use receive_signal() to deliver the signal and advance the state.\r\n"]
[13.318322, "o", "\r\n━━━ 5. Reviewer signals 'changes_requested' (role hands back) ━━━\r\n\r\n"]
[14.518535, "o", "  reviewer:\r\n  $ process_signal(\"1cb0a3\", \"review_decision\", {decision: \"changes_requested\", feedback: \"tighten paragraph 2\"})\r\n"]
[15.119102, "o", "    → state: revise    role: submitter\r\n      role handoff: reviewer → submitter\r\n"]
[16.319401, "o", "\r\n━━━ 6. Resubmit and accept (terminal) ━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n"]
[17.519803, "o", "  submitter:\r\n  $ process_transition(\"1cb0a3\", \"awaiting_review\")\r\n"]
[18.120651, "o", "    → state: awaiting_review    role: reviewer\r\n"]
[19.321234, "o", "  reviewer:\r\n  $ process_signal(\"1cb0a3\", \"review_decision\", {decision: \"accepted\", feedback: \"approved\"})\r\n"]
[19.921781, "o", "    → state: accepted    role: (none)\r\n      ✓ terminal: accepted\r\n"]
[21.122244, "o", "\r\n━━━ Done ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n"]
[22.322456, "o", "  6 transitions · 3 role handoffs · 1 illegal transition rejected\r\n\r\n"]
